    <string name="help_demo_video">* নিচের YouTube লিংক বোতামে ট্যাপ করে একটি প্রদর্শনী ভিডিও দেখা যাবে *</string>
    <string name="help_main_menu_title">প্রধান মেনুর ব্যাখ্যা</string>
    <string name="help_main_menu_categories">যে শব্দের বিভাগ শুনতে চান, সেই নামের বোতামে ক্লিক করুন শব্দের বিকল্প দেখতে।</string>
    <string name="help_main_menu_stop_all">\'সব শব্দ বন্ধ\' বোতামে ক্লিক করুন পুরো অ্যাপে বাজা সব শব্দ বন্ধ করতে।</string>
    <string name="help_sound_title">শব্দ সেটিংয়ের ব্যাখ্যা</string>
    <string name="help_sound_play">প্রতিটি শব্দ সংশ্লিষ্ট \'চালান\' বোতামে ক্লিক করে বাজে, তার উপরে শব্দের নাম থাকে। একই বোতামে আবার ক্লিক করলে শব্দ বন্ধ হয়; মিক্সার বাজলে বোতামে \'বন্ধ\' লেখা থাকে।</string>
    <string name="help_sound_volume">স্লাইডার বামে বা ডানে সরিয়ে প্রতিটি শব্দের ভলিউম ঠিক করুন।</string>
    <string name="help_sound_delay">কিছু শব্দে ভলিউম সীমা ও বিলম্ব সীমার বিকল্প থাকে। বিলম্ব স্লাইডার বামে বা ডানে সরালে ছোট শব্দ ফাইলের একটি এলোমেলো নির্বাচন আপনার বেছে নেওয়া সেকেন্ড বিলম্বে বাজবে।</string>
    <string name="help_sound_default">\'ডিফল্ট সেটিং\' বোতামে ক্লিক করুন প্রস্তাবিত সেটিংসে একটি প্রস্তাবিত শব্দসেট চালাতে।</string>
    <string name="help_sound_stop_all">স্ক্রিনের উপরে \'সব শব্দ বন্ধ\' বোতামে ক্লিক করলে সেই শব্দ বিভাগের সব বাজা শব্দ বন্ধ হবে।</string>
    <string name="help_alarm_title">অ্যালার্ম নিয়ন্ত্রণের ব্যাখ্যা</string>
    <string name="help_alarm_current_time">\'বর্তমান সময়\' লেবেলটি আপনাকে এখনকার সময় দেখাচ্ছে।</string>
    <string name="help_alarm_set">অ্যালার্ম সেট করতে: 1 যে শব্দগুলো শুনতে চান সেগুলো কাঙ্ক্ষিত ভলিউম ও বিলম্বে চালান। 2 তারপর স্ক্রিনের নিচে \'সময় ও তারিখ চাকা\' দিয়ে অ্যালার্মের সময় ও তারিখ বেছে নিন। 3 \'অ্যালার্ম সেট করুন\' বোতামে ক্লিক করুন। শব্দ বন্ধ হবে এবং আপনার সেট করা অ্যালার্মের সময় \'অ্যালার্মের সময়\' লেবেলে দেখাবে। শব্দ ও সেটিং সংরক্ষিত হয় এবং অ্যালার্মের সময় এলে আবার বাজে।</string>
    <string name="help_alarm_snooze">\'স্নুজ বোতাম\'-এ ক্লিক করলে অ্যালার্ম সাময়িকভাবে নীরব হয়। নির্বাচিত স্নুজ সময় শেষ হলে অ্যালার্ম ফিরে আসে।</string>
    <string name="help_alarm_alarm_time">\'অ্যালার্মের সময়\' লেবেল নির্বাচিত অ্যালার্মের সময় দেখাবে। লেবেলে ক্লিক করলে অ্যালার্মের শব্দ ও অ্যালার্ম কাজ বন্ধ হবে।</string>
    <string name="help_alarm_wheel">\'সময় ও তারিখ চাকা\' দিয়ে \'অ্যালার্ম সেট করুন\'-এ ক্লিক করার আগে অ্যালার্মের তারিখ ও সময় বেছে নিন।</string>
    <string name="help_timer_title">টাইমার নিয়ন্ত্রণের ব্যাখ্যা</string>
    <string name="help_timer_keypad">কিপ্যাডের সংখ্যা কী দিয়ে সেই সময় লিখুন যেখান থেকে টাইমার কাউন্টডাউন করবে।</string>
    <string name="help_timer_delete">সংখ্যা মুছতে \'মুছুন\' বোতাম ব্যবহার করুন।</string>
    <string name="help_timer_controls">\'শুরু\' বোতামে ক্লিক করে টাইমার চালু করুন। টাইমার শূন্যে পৌঁছালে সব শব্দ বন্ধ হবে। \'বিরতি\' বোতাম টাইমার থামায় এবং আবার \'শুরু\'-তে ক্লিক করলে চালু হয়। সময় মুছতে \'রিসেট\' বোতামে ক্লিক করুন।</string>
</resources>
