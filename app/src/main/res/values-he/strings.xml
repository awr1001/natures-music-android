    <string name="help_demo_video">* ניתן לצפות בסרטון הדגמה על ידי הקשה על כפתור קישור YouTube למטה *</string>
    <string name="help_main_menu_title">הסבר על התפריט הראשי</string>
    <string name="help_main_menu_categories">לחצו על הכפתור עם שם קטגוריית הצליל שתרצו לשמוע כדי להציג את אפשרויות הצליל.</string>
    <string name="help_main_menu_stop_all">לחצו על הכפתור \'עצור את כל הצלילים\' כדי לעצור את כל הצלילים המושמעים בכל היישום.</string>
    <string name="help_sound_title">הסבר על הגדרות הצליל</string>
    <string name="help_sound_play">כל צליל מושמע בלחיצה על כפתור \'נגן\' המתאים, שמעליו מוצג שם הצליל. הצליל נעצר בלחיצה על אותו כפתור, שעליו כתוב \'עצור\' בזמן שהמערבל מנגן.</string>
    <string name="help_sound_volume">כוונו את עוצמת השמע של כל צליל על ידי הזזת המחוון שמאלה או ימינה.</string>
    <string name="help_sound_delay">חלק מהצלילים מציעים אפשרויות של טווח עוצמה וטווח השהיה. הזזת מחוון ההשהיה שמאלה או ימינה קובעת בחירה אקראית של קובצי צליל קצרים שיושמעו בהשהיה בשניות שתבחרו.</string>
    <string name="help_sound_default">לחצו על הכפתור \'הגדרת ברירת מחדל\' כדי להשמיע סט צלילים מוצע בהגדרות המומלצות.</string>
    <string name="help_sound_stop_all">לחיצה על הכפתור \'עצור את כל הצלילים\' בראש המסך תעצור את כל הצלילים המושמעים בקטגוריית הצליל.</string>
    <string name="help_alarm_title">הסבר על פקדי השעון המעורר</string>
    <string name="help_alarm_current_time">התווית \'שעה נוכחית\' מציגה לך את השעה הנוכחית.</string>
    <string name="help_alarm_set">כדי לכוון שעון מעורר: 1 נגנו את כל הצלילים שתרצו לשמוע בעוצמה ובהשהיה הרצויות. 2 אחר כך בחרו את שעת השעון המעורר ואת התאריך באמצעות \'גלגל השעה והתאריך\' בתחתית המסך. 3 לחצו על הכפתור \'כוון שעון מעורר\'. הצלילים ייעצרו, ושעת השעון המעורר שהגדרתם תוצג בתווית \'שעת השעון המעורר\'. הצלילים וההגדרות נשמרים ומושמעים כשמגיעה שעת השעון המעורר.</string>
    <string name="help_alarm_snooze">לחיצה על \'כפתור נודניק\' תשתיק זמנית את השעון המעורר. השעון המעורר יחזור כשזמן הנודניק שנבחר יסתיים.</string>
    <string name="help_alarm_alarm_time">התווית \'שעת השעון המעורר\' תציג את שעת השעון המעורר שנבחרה. לחיצה על התווית תעצור את צלילי השעון המעורר ואת פעולת השעון המעורר.</string>
    <string name="help_alarm_wheel">\'גלגל השעה והתאריך\' משמש לבחירת התאריך והשעה של השעון המעורר לפני לחיצה על \'כוון שעון מעורר\'.</string>
    <string name="help_timer_title">הסבר על פקדי הטיימר</string>
    <string name="help_timer_keypad">השתמשו במקשי המספרים בלוח המקשים כדי להזין את הזמן שממנו הטיימר יספור לאחור.</string>
    <string name="help_timer_delete">השתמשו בכפתור \'מחק\' כדי למחוק ספרות.</string>
    <string name="help_timer_controls">לחצו על הכפתור \'התחל\' כדי להפעיל את הטיימר. כשהטיימר מגיע לאפס, כל הצלילים ייעצרו. הכפתור \'השהה\' עוצר את הטיימר, ואפשר להמשיך אותו בלחיצה נוספת על \'התחל\'. לחצו על הכפתור \'איפוס\' כדי למחוק את הזמן.</string>
</resources>
